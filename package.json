{
  "name": "@heroku-cli/heroku-slugs",
  "description": "Heroku CLI Plugin to manage and download slugs",
  "version": "3.0.2",
  "author": "Heroku",
  "type": "module",
  "bugs": {
    "url": "https://github.com/heroku/heroku-slugs/issues"
  },
  "dependencies": {
    "@heroku-cli/command": "~13.2.0",
    "@heroku-cli/notifications": "^1.2.7",
    "@heroku/heroku-cli-util": "10.10.0",
    "@oclif/core": "^4.3.0",
    "bytes": "^3.1.2",
    "smooth-progress": "^1.1.0",
    "tunnel-agent": "^0.6.0"
  },
  "devDependencies": {
    "@heroku-cli/schema": "^2.0.0",
    "@heroku-cli/test-utils": "^1.0.1",
    "@oclif/plugin-help": "^6",
    "@types/bytes": "^3.1.4",
    "@types/chai": "^4.3.20",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "chai": "^5.3.3",
    "eslint": "^9.39.4",
    "eslint-config-oclif": "^6.0.144",
    "fs-extra": "^11.3.0",
    "nock": "^14.0.0",
    "oclif": "^6.0.2",
    "rimraf": "^6.1.3",
    "strip-ansi": "^7.2.0",
    "tsheredoc": "^2.0.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "/dist",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "heroku-plugin",
    "oclif"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "oclif": {
    "repositoryPrefix": "<%- repo %>/blob/heroku-slugs-v<%- version %>/<%- commandPath %>",
    "commands": "./dist/commands",
    "bin": "heroku",
    "topics": {
      "slugs": {
        "description": "manage and download slugs"
      }
    }
  },
  "repository": "heroku/heroku-slugs",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -b",
    "manifest": "oclif manifest",
    "readme": "oclif readme",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=lcovonly",
    "docs:generate": "npm run build && npm run manifest && oclif readme --output-dir docs --multi",
    "prepare": "npm run build && npm run manifest",
    "postpack": "rimraf oclif.manifest.json"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
